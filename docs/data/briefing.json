  "in_force": [
    {
      "id": "fed-tcpa",
      "jurisdiction_code": "US-FED",
      "jurisdiction_label": "Federal",
      "topic": "Phone calls",
      "bucket": "in_force",
      "bucket_label": "In force",
      "bucket_css": "status-in-force",
      "blurb": "If you call cell phones with an AI voice, treat it like a robocall. You generally need written consent first. At the start of the call, say who is calling and give a real callback number. Caller ID does not need to say the call is AI.",
      "effective_date": null,
      "date_display": "pending",
      "obligation_status": "in_force",
      "sort": 10
    },
    {
      "id": "fed-ftc",
      "jurisdiction_code": "US-FED",
      "jurisdiction_label": "Federal",
      "topic": "Honesty about the bot",
      "bucket": "in_force",
      "bucket_label": "In force",
      "bucket_css": "status-in-force",
      "blurb": "Don't pretend the bot is a person, and don't oversell what the AI can do. That is already an FTC issue.",
      "effective_date": null,
      "date_display": "pending",
      "obligation_status": "in_force",
      "sort": 20
    },
    {
      "id": "me-chatbot",
      "jurisdiction_code": "ME",
      "jurisdiction_label": "Maine",
      "topic": "Chatbot disclosure",
      "bucket": "in_force",
      "bucket_label": "In force",
      "bucket_css": "status-in-force",
      "blurb": "If a chatbot talks to Maine customers and could pass as a person, tell them it is AI. Text and voice both count.",
      "effective_date": "2025-09-24",
      "date_display": "Sep 24, 2025",
      "obligation_status": "in_force",
      "sort": 30
    },
    {
      "id": "ca-bot-act",
      "jurisdiction_code": "CA",
      "jurisdiction_label": "California",
      "topic": "Bot Act",
      "bucket": "in_force",
      "bucket_label": "In force",
      "bucket_css": "status-in-force",
      "blurb": "If a bot is trying to sell something online (or influence a vote), say it is a bot.",
      "effective_date": "2019-07-01",
      "date_display": "Jul 1, 2019",
      "obligation_status": "in_force",
      "sort": 40
    },
    {
